# Demo mode: mock AI summaries + default demo password ("demo"). Safe with no other vars set.
DEMO_MODE=true
DEMO_PASSWORD=demo
# Random string (>=32 chars) used to sign session cookies. REQUIRED outside DEMO_MODE.
SESSION_SECRET=
# Bearer token Vercel Cron sends to /api/cron/weekly
CRON_SECRET=
# Optional: Supabase Postgres. Unset = seeded in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: real AI summaries (ignored when DEMO_MODE=true)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
